PORT=3000

# SMTP settings (optional - without them messages are still saved to the database)
# Gmail example: host smtp.gmail.com, port 587, use an App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your-app-password

# Where notifications are sent (defaults to SMTP_USER)
NOTIFY_TO=you@example.com
MAIL_FROM="Portfolio <you@example.com>"
